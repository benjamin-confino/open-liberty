# btags/GNUmakefile.incremental
#
# Incremental build — invoked automatically by GNUmakefile when a previous
# cold build has been detected (btags/ctags/parts/ exists).
#
# ⚠️  CAUTION — hand-editing this file requires care.  The staleness checks,
#    stamp ordering, and recipe-time vs parse-time variable evaluation are
#    deliberately structured to avoid races in the incremental build chain.
#    Do not reorder or simplify recipes without understanding the full chain.
#
# Design goal: repeated makes with no source changes are near-noops.
#
# Each stage uses a per-component stamp file.  Make only runs a component's
# recipe when the stamp is absent or older than the component's output file.
# The component output file (e.g. java_hl.tags) is only updated by
# ctags_part.sh when it detects actual source changes via find -newer —
# so the stamp chain only propagates when real work was done.
#
#   Source files  →  ctags_part.sh  →  .tags partial   →  ctags/.stamps/*.stamp
#                                          ↓
#   .tags partial →  ftags.sh       →  .fns file       →  (reuses ftags stamps)
#                                          ↓
#   .tags partial →  stags stamp    →  stags parts     →  stags sentinel
#   .fns file     →  ltags stamp    →  .range files
#   .fns file     →  xtags stamp    →  .calls files    →  xtags merged
#
# Passed in from GNUmakefile:
#   BTAGS_DIR, ROOT, CTAGS_BIN, CTAGS_JOBS, FTAGS_JOBS

MAKEFLAGS += --no-builtin-rules
.SUFFIXES:

.DEFAULT_GOAL := tags

# ---------------------------------------------------------------------------
# Paths (mirrors GNUmakefile)
# ---------------------------------------------------------------------------

CTAGS_DIR := $(BTAGS_DIR)/ctags
FTAGS_DIR := $(BTAGS_DIR)/ftags
STAGS_DIR := $(BTAGS_DIR)/stags

GEN_FTAGS_SH      := $(FTAGS_DIR)/ftags.sh
GEN_STAGS_SH      := $(STAGS_DIR)/gen_stags.sh
GEN_STAGS_ALL_SH  := $(STAGS_DIR)/gen_stags_all.sh
MERGE_CTAGS_SH    := $(CTAGS_DIR)/merge_ctags.sh
CTAGS_PART_SH     := $(CTAGS_DIR)/ctags_part.sh

CTAGS_FILE       := $(CTAGS_DIR)/tags
CTAGS_PARTS_DIR  := $(CTAGS_DIR)/parts
CTAGS_STAMPS_DIR := $(CTAGS_DIR)/.stamps

FTAGS_DIR_OUT  := $(FTAGS_DIR)
FTAGS_ALL_FILE := $(FTAGS_DIR)/l.tsv
FTAGS_FNS_DIR  := $(FTAGS_DIR)/.fns

STAGS_STAMPS_DIR := $(STAGS_DIR)/.stamps
STAGS_SENTINEL   := $(STAGS_DIR)/a.tsv

LTAGS_DIR        := $(BTAGS_DIR)/ltags
LTAGS_STAMPS_DIR := $(LTAGS_DIR)/.stamps
GEN_LTAGS_SH     := $(LTAGS_DIR)/gen_ltags.sh

XTAGS_DIR         := $(BTAGS_DIR)/xtags
XTAGS_ALL_FILE    := $(XTAGS_DIR)/l.tsv
XTAGS_CALLS_DIR   := $(XTAGS_DIR)/.calls
XTAGS_STAMPS_DIR  := $(XTAGS_DIR)/.stamps
GEN_XTAGS_COMP_SH := $(XTAGS_DIR)/gen_xtags_comp.sh
XTAGS_MERGE_SH    := $(XTAGS_DIR)/xtags_merge.sh

# ---------------------------------------------------------------------------
# Source discovery (same filters as GNUmakefile)
# ROOT is passed in from GNUmakefile and already resolved for both embedded
# and standalone (BTAGS_SOURCE) modes.
# ---------------------------------------------------------------------------

JAVA_COMP_DIRS := $(shell \
  { find $(ROOT) -maxdepth 2 -name "com" -type d 2>/dev/null; \
    find $(ROOT) -maxdepth 5 -path "*/src/main/java/com" -type d 2>/dev/null; } \
  | grep -v '/be_decaf/\|/JavaParser/\|/cli_autogen/\|/ip_quorum/\|/bin/\|/btags/' \
  | sed 's|/com$$||' | sort)

C_SRC_SUBDIRS := $(shell find $(ROOT)/src/user -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort)

comp_to_part      = $(CTAGS_PARTS_DIR)/java_$(notdir $(1)).tags
c_subdir_to_part  = $(CTAGS_PARTS_DIR)/c_src_$(notdir $(1)).tags
comp_to_stamp     = $(CTAGS_STAMPS_DIR)/java_$(notdir $(1)).stamp
c_subdir_to_stamp = $(CTAGS_STAMPS_DIR)/c_src_$(notdir $(1)).stamp

CTAGS_JAVA_PARTS  := $(foreach d,$(JAVA_COMP_DIRS),$(call comp_to_part,$(d)))
CTAGS_C_SRC_PARTS := $(foreach d,$(C_SRC_SUBDIRS),$(call c_subdir_to_part,$(d)))
CTAGS_ALL_PARTS   := $(CTAGS_JAVA_PARTS) $(CTAGS_C_SRC_PARTS)

CTAGS_JAVA_STAMPS  := $(foreach d,$(JAVA_COMP_DIRS),$(call comp_to_stamp,$(d)))
CTAGS_C_SRC_STAMPS := $(foreach d,$(C_SRC_SUBDIRS),$(call c_subdir_to_stamp,$(d)))
CTAGS_ALL_STAMPS   := $(CTAGS_JAVA_STAMPS) $(CTAGS_C_SRC_STAMPS)

java_comp_to_fns = $(FTAGS_FNS_DIR)/java_$(notdir $(1)).fns
c_subdir_to_fns  = $(FTAGS_FNS_DIR)/c_src_$(notdir $(1)).fns
FTAGS_JAVA_FNS := $(foreach d,$(JAVA_COMP_DIRS),$(call java_comp_to_fns,$(d)))
FTAGS_C_FNS    := $(foreach d,$(C_SRC_SUBDIRS),$(call c_subdir_to_fns,$(d)))
FTAGS_ALL_FNS  := $(FTAGS_JAVA_FNS) $(FTAGS_C_FNS)

part_to_stag_stamp = $(STAGS_STAMPS_DIR)/$(basename $(notdir $(1))).stamp
fns_to_ltags_stamp = $(LTAGS_STAMPS_DIR)/$(basename $(notdir $(1))).stamp
fns_to_xtags_stamp = $(XTAGS_STAMPS_DIR)/$(basename $(notdir $(1))).stamp

STAGS_STAMPS     := $(foreach p,$(CTAGS_ALL_PARTS),$(call part_to_stag_stamp,$(p)))
LTAGS_FNS_STAMPS := $(foreach f,$(FTAGS_ALL_FNS),$(call fns_to_ltags_stamp,$(f)))
XTAGS_FNS_STAMPS := $(foreach f,$(FTAGS_ALL_FNS),$(call fns_to_xtags_stamp,$(f)))

# ---------------------------------------------------------------------------
# Stale-component detection — 5 script invocations total (fast parse).
#
# find_stale.sh does one pass over all components per stage and emits only
# the stale ones as a space-separated list.  This keeps makefile parse time
# under ~0.5s regardless of component count.
# ---------------------------------------------------------------------------
FIND_STALE_SH := $(BTAGS_DIR)/find_stale.sh

STALE_JAVA_COMPS  := $(shell bash $(FIND_STALE_SH) ctags-java $(ROOT) $(CTAGS_STAMPS_DIR) $(JAVA_COMP_DIRS))
STALE_C_SUBDIRS   := $(shell bash $(FIND_STALE_SH) ctags-c   $(ROOT) $(CTAGS_STAMPS_DIR) $(C_SRC_SUBDIRS))
STALE_JAVA_STAMPS := $(foreach d,$(STALE_JAVA_COMPS),$(call comp_to_stamp,$(d)))
STALE_C_STAMPS    := $(foreach d,$(STALE_C_SUBDIRS),$(call c_subdir_to_stamp,$(d)))
STALE_ALL_STAMPS  := $(strip $(STALE_JAVA_STAMPS) $(STALE_C_STAMPS))

# NOTE: stags, ltags and xtags staleness is intentionally NOT evaluated at parse time.
#
# stags depends on .tags partials written by ctags_part.sh during the ctags
# recipe.  ltags/xtags depend on .fns files written by the ftags recipe.
# Evaluating $(shell find_stale.sh ...) here snapshots those timestamps before
# the upstream recipe runs and always reports "Up to date" when the upstream
# stage updated its output in the same make invocation.
# Staleness for all three stages is instead computed at recipe-execution time.

# ---------------------------------------------------------------------------
# Top-level
# ---------------------------------------------------------------------------

.PHONY: tags btags ctags ftags stags ltags xtags

tags btags: ctags ftags stags ltags xtags
	@echo ""
	@echo "🗂️  Bob tag indexes written. Incremental make enabled."
	@echo ""

# ===========================================================================
# ctags — stamp-gated: only stale components invoke ctags_part.sh
# ===========================================================================

.PHONY: ctags _inc_ctags_stamps

ctags: | $(CTAGS_STAMPS_DIR) $(CTAGS_PARTS_DIR)
ifneq ($(STALE_ALL_STAMPS),)
	@echo "[ctags] Using ctags to scan $(words $(STALE_JAVA_COMPS)) Java + $(words $(STALE_C_SUBDIRS)) C changed components (-j$(CTAGS_JOBS)) ..."
	@$(MAKE) --no-print-directory -s -j$(CTAGS_JOBS) -f $(BTAGS_DIR)/GNUmakefile.incremental \
	    BTAGS_DIR="$(BTAGS_DIR)" ROOT="$(ROOT)" CTAGS_BIN="$(CTAGS_BIN)" \
	    CTAGS_JOBS="$(CTAGS_JOBS)" FTAGS_JOBS="$(FTAGS_JOBS)" \
	    _inc_ctags_stamps; printf "\r\033[K" >&2
	@if [ -n "$$(find $(CTAGS_PARTS_DIR) -name '*.tags' \
	               -newer $(CTAGS_FILE) 2>/dev/null | head -1)" ] \
	      || [ ! -f $(CTAGS_FILE) ]; then \
	    bash $(MERGE_CTAGS_SH) $(CTAGS_PARTS_DIR) $(CTAGS_FILE); \
	else \
	    echo "[ctags] Up to date."; \
	fi
else
	@echo "[ctags] Up to date."
endif

_inc_ctags_stamps: $(STALE_ALL_STAMPS)

define INC_CTAGS_JAVA_RULE
$(call comp_to_stamp,$(1)): | $(CTAGS_STAMPS_DIR)
	@printf "\r\033[K[ctags]   $(notdir $(1)) (Java)" >&2
	@bash $(CTAGS_PART_SH) $(CTAGS_BIN) Java cgimpf $(1) $(call comp_to_part,$(1)) \
	  && touch $$@
endef
$(foreach d,$(STALE_JAVA_COMPS),$(eval $(call INC_CTAGS_JAVA_RULE,$(d))))

define INC_CTAGS_C_RULE
$(call c_subdir_to_stamp,$(1)): | $(CTAGS_STAMPS_DIR)
	@printf "\r\033[K[ctags]   src/$(notdir $(1)) (C+H)" >&2
	@bash $(CTAGS_PART_SH) $(CTAGS_BIN) C dfgstu $(1) $(call c_subdir_to_part,$(1)) \
	  && touch $$@
endef
$(foreach d,$(STALE_C_SUBDIRS),$(eval $(call INC_CTAGS_C_RULE,$(d))))

# ===========================================================================
# ftags — stamp-gated: only stale components invoke ftags.sh
# ===========================================================================

# Detect ftags staleness directly: any .java/.c/.h newer than the .fns file,
# or .fns absent.  This works whether the trigger was a full make (ctags ran
# first and updated stamps) or a bare 'make ftags' (no ctags run at all).
STALE_FTAGS_JAVA := $(shell bash $(FIND_STALE_SH) ftags-java $(FTAGS_FNS_DIR) $(JAVA_COMP_DIRS))
STALE_FTAGS_C    := $(shell bash $(FIND_STALE_SH) ftags-c    $(FTAGS_FNS_DIR) $(C_SRC_SUBDIRS))

.PHONY: ftags _inc_ftags_fns

ftags: | $(FTAGS_FNS_DIR)
ifneq ($(or $(STALE_FTAGS_JAVA),$(STALE_FTAGS_C)),)
	@echo "[ftags] Scanning $(words $(STALE_FTAGS_JAVA)) Java + $(words $(STALE_FTAGS_C)) C changed components (-j$(FTAGS_JOBS)) ..."
	@$(MAKE) --no-print-directory -s -j$(FTAGS_JOBS) -f $(BTAGS_DIR)/GNUmakefile.incremental \
	    BTAGS_DIR="$(BTAGS_DIR)" ROOT="$(ROOT)" CTAGS_BIN="$(CTAGS_BIN)" \
	    CTAGS_JOBS="$(CTAGS_JOBS)" FTAGS_JOBS="$(FTAGS_JOBS)" \
	    _inc_ftags_fns; printf "\r\033[K" >&2
	@if [ -z "$$(find $(FTAGS_FNS_DIR) -name '*.fns' \
	               -newer $(FTAGS_ALL_FILE) 2>/dev/null | head -1)" ] \
	      && [ -f $(FTAGS_ALL_FILE) ]; then \
	    echo "[ftags] Up to date."; \
	else \
	    $(FTAGS_DIR)/ftags_merge.sh $(FTAGS_FNS_DIR) $(FTAGS_DIR_OUT) \
	        $(foreach d,$(STALE_FTAGS_JAVA),$(notdir $(d))) \
	        $(foreach d,$(STALE_FTAGS_C),$(notdir $(d))); \
	    awk -F'\t' '{print $$1}' $(FTAGS_DIR)/[a-z_].tsv \
	        | sort -u > $(FTAGS_DIR)/known_names.tsv; \
	fi
else
	@echo "[ftags] Up to date."
endif

_inc_ftags_fns: $(foreach d,$(STALE_FTAGS_JAVA),$(call java_comp_to_fns,$(d))) \
                $(foreach d,$(STALE_FTAGS_C),$(call c_subdir_to_fns,$(d)))

define INC_FTAGS_JAVA_RULE
.PHONY: $(call java_comp_to_fns,$(1))
$(call java_comp_to_fns,$(1)): | $(FTAGS_FNS_DIR) $(CTAGS_STAMPS_DIR)
	@printf "\r\033[K[ftags]   $(notdir $(1)) (Java)" >&2
	@$(GEN_FTAGS_SH) $(1)/com $(ROOT) $(CTAGS_BIN) $$@ > $$@.tmp \
	  && { [ -s $$@.tmp ] && mv $$@.tmp $$@ || { rm -f $$@.tmp; touch $$@; }; } \
	  || { rm -f $$@.tmp; echo "[ftags] WARNING: failed $(notdir $(1))"; touch $$@; }
	@touch $(call comp_to_stamp,$(1))
endef
$(foreach d,$(STALE_FTAGS_JAVA),$(eval $(call INC_FTAGS_JAVA_RULE,$(d))))

define INC_FTAGS_C_RULE
.PHONY: $(call c_subdir_to_fns,$(1))
$(call c_subdir_to_fns,$(1)): | $(FTAGS_FNS_DIR) $(CTAGS_STAMPS_DIR)
	@printf "\r\033[K[ftags]   src/$(notdir $(1)) (C)" >&2
	@$(GEN_FTAGS_SH) $(1) $(ROOT) $(CTAGS_BIN) $$@ > $$@.tmp \
	  && { [ -s $$@.tmp ] && mv $$@.tmp $$@ || { rm -f $$@.tmp; touch $$@; }; } \
	  || { rm -f $$@.tmp; echo "[ftags] WARNING: failed src/$(notdir $(1))"; touch $$@; }
	@touch $(call c_subdir_to_stamp,$(1))
endef
$(foreach d,$(STALE_FTAGS_C),$(eval $(call INC_FTAGS_C_RULE,$(d))))

# ===========================================================================
# stags — stamp-gated: only changed components re-run gen_stags.sh
#
# Staleness uses the same source-level check as ctags (any .java/.c/.h newer
# than the stags stamp for that component).  This avoids the parse-time race
# that plagued the old approach (comparing .tags mtime vs stags stamp mtime —
# both get set in the same make run so the comparison always ties).
# ===========================================================================

.PHONY: stags

stags: | $(STAGS_STAMPS_DIR)
	@_stale_java=$$(bash $(FIND_STALE_SH) ctags-java $(ROOT) $(STAGS_STAMPS_DIR) $(JAVA_COMP_DIRS)); \
	 _stale_c=$$(bash $(FIND_STALE_SH) ctags-c $(ROOT) $(STAGS_STAMPS_DIR) $(C_SRC_SUBDIRS)); \
	 if [ -z "$$_stale_java" ] && [ -z "$$_stale_c" ] && [ -f $(STAGS_SENTINEL) ]; then \
	     echo "[stags] Up to date."; \
	 else \
	     _count_stale=$$(echo "$$_stale_java $$_stale_c" | wc -w | tr -d ' '); \
	     echo "[stags] Building Bob-specific index from $$_count_stale changed components ..."; \
	     _changed_comps=""; \
	     for _comp in $$_stale_java; do \
	         _name="java_$${_comp##*/}"; \
	         _tags=$(CTAGS_PARTS_DIR)/$${_name}.tags; \
	         _stamp=$(STAGS_STAMPS_DIR)/$${_name}.stamp; \
	         if [ ! -f "$$_tags" ]; then echo "[stags] skipping $$_name — run 'make ctags' first" >&2; continue; fi; \
	         bash $(GEN_STAGS_SH) $(ROOT) "$$_tags" $(STAGS_DIR); touch "$$_stamp"; \
	         _changed_comps="$$_changed_comps $${_comp##*/}"; \
	     done; \
	     for _subdir in $$_stale_c; do \
	         _name="c_src_$${_subdir##*/}"; \
	         _tags=$(CTAGS_PARTS_DIR)/$${_name}.tags; \
	         _stamp=$(STAGS_STAMPS_DIR)/$${_name}.stamp; \
	         if [ ! -f "$$_tags" ]; then echo "[stags] skipping $$_name — run 'make ctags' first" >&2; continue; fi; \
	         bash $(GEN_STAGS_SH) $(ROOT) "$$_tags" $(STAGS_DIR); touch "$$_stamp"; \
	         _changed_comps="$$_changed_comps src"; \
	     done; \
	     if [ -n "$$(find $(STAGS_STAMPS_DIR) -name '*.stamp' \
	                    -newer $(STAGS_SENTINEL) 2>/dev/null | head -1)" ] \
	           || [ ! -f $(STAGS_SENTINEL) ]; then \
	         bash $(GEN_STAGS_ALL_SH) $(STAGS_DIR) $$_changed_comps; \
	     else \
	         echo "[stags] Up to date."; \
	     fi; \
	 fi

# ===========================================================================
# ltags — stamp-gated: only stale .fns files re-run gen_ltags.sh
#
# Staleness is computed at recipe-execution time (not parse time) because the
# .fns files may have been updated by the ftags recipe earlier in this same
# make invocation.  A parse-time $(shell find_stale.sh fns ...) would snapshot
# the old .fns timestamps and falsely report "Up to date".
# ===========================================================================

.PHONY: ltags

ltags: | $(LTAGS_STAMPS_DIR)
	@_stale=$$(bash $(FIND_STALE_SH) fns $(LTAGS_STAMPS_DIR) $(FTAGS_ALL_FNS)); \
	 if [ -z "$$_stale" ]; then \
	     echo "[ltags] Up to date."; \
	 else \
	     _count_stale=$$(echo "$$_stale" | wc -w | tr -d ' '); \
	     echo "[ltags] Building line-range index from $$_count_stale changed .fns files ..."; \
	     for _fns in $$_stale; do \
	         _base=$${_fns##*/}; _base=$${_base%.fns}; \
	         _stamp=$(LTAGS_STAMPS_DIR)/$$_base.stamp; \
	         bash $(GEN_LTAGS_SH) "$$_fns" $(LTAGS_DIR) && touch "$$_stamp" \
	           || { echo "[ltags] WARNING: failed to split $$_base.fns"; touch "$$_stamp"; }; \
	     done; \
	     _count=$$(ls $(LTAGS_DIR)/*.range 2>/dev/null | wc -l | tr -d ' '); \
	     printf "\r\033[K[ltags] Made Bob-friendly line-range index  ($$_count source files indexed)\n"; \
	 fi

$(LTAGS_DIR):
	@mkdir -p $@

$(LTAGS_STAMPS_DIR): | $(LTAGS_DIR)
	@mkdir -p $@

# ===========================================================================
# xtags — stamp-gated: only stale .fns files re-run gen_xtags_comp.sh
#
# Same rationale as ltags: staleness computed at recipe-execution time.
# ===========================================================================

.PHONY: xtags

xtags: | $(XTAGS_CALLS_DIR) $(XTAGS_STAMPS_DIR)
	@_stale=$$(bash $(FIND_STALE_SH) fns $(XTAGS_STAMPS_DIR) $(FTAGS_ALL_FNS)); \
	 if [ -z "$$_stale" ] && [ -f $(XTAGS_ALL_FILE) ]; then \
	     echo "[xtags] Up to date."; \
	 else \
	     _count_stale=$$(echo "$$_stale" | wc -w | tr -d ' '); \
	     echo "[xtags] Scanning $$_count_stale changed .fns files for call sites ..."; \
	     _changed_comps=""; \
	     for _fns in $$_stale; do \
	         _base=$${_fns##*/}; _base=$${_base%.fns}; \
	         _stamp=$(XTAGS_STAMPS_DIR)/$$_base.stamp; \
	         bash $(GEN_XTAGS_COMP_SH) "$$_fns" $(ROOT) $(ROOT) $(XTAGS_CALLS_DIR) \
	           && touch "$$_stamp" \
	           || { echo "[xtags] WARNING: failed $$_base.fns"; touch "$$_stamp"; }; \
	         _stem=$$_base; \
	         case "$$_stem" in \
	             java_*)   _changed_comps="$$_changed_comps $${_stem#java_}" ;; \
	             c_src_*)  _changed_comps="$$_changed_comps src" ;; \
	         esac; \
	     done; \
	     if [ -z "$$(find $(XTAGS_CALLS_DIR) -name '*.calls' \
	                    -newer $(XTAGS_ALL_FILE) 2>/dev/null | head -1)" ] \
	           && [ -f $(XTAGS_ALL_FILE) ]; then \
	         echo "[xtags] Up to date."; \
	     else \
	         bash $(XTAGS_MERGE_SH) $(XTAGS_CALLS_DIR) $(XTAGS_DIR) $(FTAGS_DIR) $$_changed_comps; \
	     fi; \
	 fi

$(XTAGS_DIR):
	@mkdir -p $@

$(XTAGS_CALLS_DIR): | $(XTAGS_DIR)
	@mkdir -p $@

$(XTAGS_STAMPS_DIR): | $(XTAGS_DIR)
	@mkdir -p $@

# ===========================================================================
# Directory guards (shared)
# ===========================================================================

$(CTAGS_PARTS_DIR):
	@mkdir -p $@

$(CTAGS_STAMPS_DIR): | $(CTAGS_DIR)
	@mkdir -p $@

$(FTAGS_FNS_DIR):
	@mkdir -p $@

$(STAGS_DIR):
	@mkdir -p $@

$(STAGS_STAMPS_DIR): | $(STAGS_DIR)
	@mkdir -p $@

$(CTAGS_DIR):
	@mkdir -p $@
